#!name=ACCK AC币每日签到 v2.0.0
#!desc=ACCK 每日签到；严格区分签到成功、重复签到、签到失败。Token 通过 Loon 参数持久化读取，脚本日志包含版本号。
#!author=weizhiok
#!homepage=https://github.com/weizhiok/loon
#!icon=https://acck.io/favicon.ico
#!tag=签到,ACCK,AC币
#!loon_version=3.2.1(733)

[Argument]
acckToken = input,"",tag=ACCK Token,desc=填写浏览器 localStorage 中 auth_token 的完整值，不要添加 Bearer 前缀。
acckCron = input,"0 9 * * *",tag=签到时间,desc=Cron 格式：分 时 日 月 周；默认每天 09:00 自动签到。

[Script]
cron {acckCron} script-path=https://raw.githubusercontent.com/weizhiok/loon/main/script/acck-checkin-v2.0.0.js,tag=ACCK自动签到 v2.0.0,timeout=180,argument=[{acckToken}],enable=true
generic script-path=https://raw.githubusercontent.com/weizhiok/loon/main/script/acck-checkin-v2.0.0.js,tag=手动签到 v2.0.0,timeout=180,argument=[{acckToken}],enable=true

