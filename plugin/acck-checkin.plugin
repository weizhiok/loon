#!name=ACCK AC币每日签到
#!desc=每天自动签到 ACCK AC币商店。支持自定义 Cron 与 Token；结果严格分为：签到成功 / 已重复签到 / 签到失败。
#!author=weizhiok
#!homepage=https://github.com/weizhiok/loon
#!icon=https://acck.io/favicon.ico
#!tag=签到,ACCK,AC币
#!loon_version=3.2.1(733)

[Argument]
token = input,"",tag=Token,desc=从浏览器 localStorage 的 auth_token 读取的登录 Token（Bearer JWT）。失效后重新抓取并粘贴到这里。
cron = input,"0 9 * * *",tag=签到时间,desc=Cron 格式：分 时 日 月 周。默认每天 09:00 自动签到。

[Script]
cron {cron} script-path=https://raw.githubusercontent.com/weizhiok/loon/main/script/acck-checkin.js, tag=ACCK自动签到, timeout=60, argument=[{token}], enable=true
generic script-path=https://raw.githubusercontent.com/weizhiok/loon/main/script/acck-checkin.js, tag=手动签到, timeout=60, argument=[{token}], enable=true
